{
  "expo": {
    "name": "TalalMind",
    "slug": "talalmind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "talalmind",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talalmind.app",
      "appleTeamId": "YOUR_TEAM_ID",
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.talalmind.blocker"
        ]
      }
    },
    "android": {
      "package": "com.talalmind.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-app-blocker",
        {
          "ios": {
            "appGroup": "group.com.talalmind.blocker",
            "shield": {
              "title": "Focus Mode Active!",
              "subtitle": "{appName} is blocked during your focus session.",
              "primaryButtonLabel": "Back to TalalMind",
              "primaryButtonColor": "#6366F1",
              "backgroundColor": "#090A0F",
              "backgroundBlurStyle": "systemThickMaterialDark"
            }
          },
          "android": {
            "notificationTitle": "TalalMind Focus",
            "notificationText": "{appName} is blocked. Stay focused!"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.talalmind.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.talalmind.blocker"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.talalmind.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.talalmind.blocker"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.talalmind.app.DeviceActivityMonitor",
                  "targetName": "DeviceActivityMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.talalmind.blocker"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "bc68844e-dd15-471f-9230-aad8f2d9d2a8"
      }
    }
  }
}
