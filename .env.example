EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase Auth account used by the app to log in (email/password auth).
# Create the user once in the Supabase dashboard: Authentication -> Add user.
# Never commit real credentials to the repo.
EXPO_PUBLIC_SUPABASE_EMAIL=you@example.com
EXPO_PUBLIC_SUPABASE_PASSWORD=your-password
